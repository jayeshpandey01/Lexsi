# ==============================================================================
# Lexsi Track 3: Production-Grade Tool-Using Agent Configuration
# ==============================================================================
# Copy this file to .env and configure your credentials.
# Do NOT commit .env containing real secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM INFERENCE PROVIDERS & API KEYS (Choose one or more)
# ------------------------------------------------------------------------------

# OpenRouter API (Access to free SOTA models: Llama-3.3-70B, DeepSeek-R1, Qwen-2.5)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API=your_openrouter_api_key_here

# NVIDIA NIM API (1,000 free API credits for Nemotron-70B, Llama-3.1, Cohere Aya)
# Get your free key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Groq Cloud API (High-speed LPU inference, 14,400 free requests/day)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Access Token (For serverless inference & publishing trained adapters)
# Get your free token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Cohere API Key (Optional: 1,000 free monthly trial calls)
# Get your free key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here


# ------------------------------------------------------------------------------
# 2. ACTIVE MODEL ROUTING & GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------

# Primary provider for runtime agent decisions: [openrouter | nvidia | groq | local]
DEFAULT_MODEL_PROVIDER=openrouter

# Primary model identifier (Free models on OpenRouter end with :free)
# Examples:
#   - meta-llama/llama-3.3-70b-instruct:free
#   - deepseek/deepseek-r1:free
#   - qwen/qwen-2.5-coder-32b-instruct:free
#   - google/gemini-2.0-flash-exp:free
DEFAULT_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free

# Automatic fallback provider and model if primary fails or hits rate limits
FALLBACK_MODEL_PROVIDER=nvidia
FALLBACK_MODEL_NAME=meta-llama/llama-3.1-70b-instruct

# Inference Hyperparameters
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=2048
MODEL_TIMEOUT_SECONDS=30.0
MODEL_MAX_RETRIES=3
MODEL_RETRY_BACKOFF_FACTOR=1.5


# ------------------------------------------------------------------------------
# 3. PRODUCTION DATABASE & REAL RELATIONAL DATA CONFIGURATION
# ------------------------------------------------------------------------------

# Database Connection URL (Async SQLAlchemy compatible)
# Local SQLite (Async, zero cloud dependency):
DATABASE_URL=sqlite+aiosqlite:///./data/lexsi_production.db
ALLOW_LOCAL_DB_FALLBACK=true
#
# Production Cloud Turso libSQL:
# DATABASE_URL="libsql://your-turso-database-host.turso.io"
# TURSO_AUTH_TOKEN="your_turso_jwt_auth_token_here"
#
# Production Cloud PostgreSQL (e.g. Neon Serverless Postgres or Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.neon.tech/lexsi?sslmode=require

# Database Connection Pool Settings (For handling concurrent users)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_ECHO_SQL=false

# Real Enterprise Dataset Fixture Path
REAL_DATASET_PATH=./data/enterprise_supply_chain.db


# ------------------------------------------------------------------------------
# 4. AGENT OBSERVABILITY, TRACING & TELEMETRY
# ------------------------------------------------------------------------------

# Langfuse Observability (50,000 free monthly traces)
# Get keys at: https://cloud.langfuse.com
ENABLE_LANGFUSE_TRACING=true
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Arize Phoenix Local Tracing (Optional: 100% free local notebook/terminal UI)
ENABLE_PHOENIX_TRACING=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006





# ------------------------------------------------------------------------------
# 5. MULTI-TENANT RUNTIME LIMITS & SECURITY GUARDRAILS
# ------------------------------------------------------------------------------

# Maximum tool interaction turns per user task before forced termination
MAX_STEPS_PER_EPISODE=10

# Per-call timeout for tool queries (seconds)
PER_CALL_TOOL_TIMEOUT=5.0

# Rate Limiting: Maximum requests per minute per tenant/IP
RATE_LIMIT_RPM=60

# Maximum concurrent active agent sessions
MAX_CONCURRENT_SESSIONS=50

# Strict recursive PII & secret redaction in trace logs
ENABLE_STRICT_REDACTION=true


# ------------------------------------------------------------------------------
# 6. POST-TRAINING & HUGGING FACE HUB (AgentTune SFT + GRPO)
# ------------------------------------------------------------------------------

# Base open-weights model to adapt
BASE_MODEL_NAME_OR_PATH=CohereLabs/aya-expanse-8b

# Target Hugging Face repository for publishing versioned LoRA adapters
HF_REPO_ID=your_username/lexsi-tool-calling-aya-8b

# Checkpoint & Training Artifacts Directory
TRAINING_OUTPUT_DIR=./results/checkpoints

# Weights & Biases Logging (Optional: for experiment tracking)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=lexsi-track3-agentic-finetuning

